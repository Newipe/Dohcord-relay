#!/usr/bin/env bash
# Dohcord Relay - certbot deploy hook.
#
# Runs only after a certificate was successfully issued or renewed. It verifies
# that the new certificate really covers this relay's public name, publishes
# copies where the unprivileged services can read them, and reloads every
# consumer of the certificate.
#
# Installed at /usr/local/bin/dohcord-relay-tls-deploy by install.sh.
set -Eeuo pipefail

MODE="${DOHCORD_RELAY_MODE:-@MODE@}"
PUBLIC_IP="${DOHCORD_RELAY_PUBLIC_IP:-@PUBLIC_IP@}"
PUBLIC_HOST="${DOHCORD_RELAY_PUBLIC_HOST:-@PUBLIC_HOST@}"
CERT_NAME="${DOHCORD_RELAY_CERT_NAME:-dohcord-relay}"
SRC_DIR="/etc/letsencrypt/live/${CERT_NAME}"
DST_DIR="/etc/dohcord-relay/tls"
GROUP="dohcord-relay"
API_UNIT="dohcord-relay-api.service"
SQUID_UNIT="dohcord-relay-squid.service"
COTURN_UNIT="${DOHCORD_RELAY_COTURN_UNIT:-dohcord-relay-coturn.service}"

log() { printf 'dohcord-relay-tls-deploy: %s\n' "$*"; }
warn() { printf 'dohcord-relay-tls-deploy: warning: %s\n' "$*" >&2; }
die() {
	printf 'dohcord-relay-tls-deploy: error: %s\n' "$*" >&2
	exit 1
}

[[ ${EUID} -eq 0 ]] || die "must run as root"

[[ -r "${SRC_DIR}/fullchain.pem" ]] || die "missing ${SRC_DIR}/fullchain.pem"
[[ -r "${SRC_DIR}/privkey.pem" ]] || die "missing ${SRC_DIR}/privkey.pem"

# The whole point of checking the name: clients reject a TLS connection whose
# certificate does not contain the authority they connected to.
if [[ "${MODE}" == "domain" ]]; then
	if ! openssl x509 -in "${SRC_DIR}/fullchain.pem" -noout -checkhost "${PUBLIC_HOST}" >/dev/null 2>&1; then
		die "certificate in ${SRC_DIR} does not cover ${PUBLIC_HOST}"
	fi
else
	if ! openssl x509 -in "${SRC_DIR}/fullchain.pem" -noout -checkip "${PUBLIC_IP}" >/dev/null 2>&1; then
		die "certificate in ${SRC_DIR} does not cover IP ${PUBLIC_IP}"
	fi
fi

install -d -m 0755 -o root -g root "${DST_DIR}"
# Copy rather than symlink: /etc/letsencrypt/live is root-only, and the services
# run unprivileged.
install -m 0644 -o root -g root "${SRC_DIR}/fullchain.pem" "${DST_DIR}/fullchain.pem"
install -m 0640 -o root -g "${GROUP}" "${SRC_DIR}/privkey.pem" "${DST_DIR}/privkey.pem"

# Squid's https_port reads the certificate and its key from one PEM file when
# built against OpenSSL, so publish a combined copy that only Squid can read.
squid_pem="${DST_DIR}/squid.pem"
cat "${SRC_DIR}/fullchain.pem" "${SRC_DIR}/privkey.pem" >"${squid_pem}.new"
if getent group proxy >/dev/null 2>&1; then
	chown root:proxy "${squid_pem}.new"
else
	warn "group 'proxy' does not exist yet; keeping ${squid_pem} root-owned"
	chown root:root "${squid_pem}.new"
fi
chmod 0640 "${squid_pem}.new"
mv "${squid_pem}.new" "${squid_pem}"

expiry="$(openssl x509 -in "${DST_DIR}/fullchain.pem" -noout -enddate | cut -d= -f2)"
log "installed certificate for ${PUBLIC_HOST} (expires ${expiry})"

reload_unit() {
	local unit="$1"
	if ! systemctl cat "${unit}" >/dev/null 2>&1; then
		log "${unit} is not installed yet, skipping"
		return 0
	fi
	if ! systemctl is-active --quiet "${unit}"; then
		log "${unit} is not running, skipping reload"
		return 0
	fi
	log "restarting ${unit}"
	systemctl restart "${unit}"
}

# Squid re-reads its TLS certificate on SIGHUP. A reload keeps established
# tunnels alive; fall back to a restart if the reload is refused.
reload_squid() {
	if ! systemctl cat "${SQUID_UNIT}" >/dev/null 2>&1; then
		log "${SQUID_UNIT} is not installed yet, skipping"
		return 0
	fi
	if ! systemctl is-active --quiet "${SQUID_UNIT}"; then
		log "${SQUID_UNIT} is not running, skipping reload"
		return 0
	fi
	if systemctl reload "${SQUID_UNIT}" 2>/dev/null; then
		log "reloaded ${SQUID_UNIT}"
	else
		warn "reload of ${SQUID_UNIT} failed; restarting it"
		systemctl restart "${SQUID_UNIT}"
	fi
}

reload_unit "${API_UNIT}"
reload_unit "${COTURN_UNIT}"
reload_squid

log "done"
