#!/usr/bin/env bash
# Pishcord Relay - per-client-IP bandwidth enforcement with Linux tc.
#
# The relay enforces bandwidth per *client IP*, not per connection:
#
#   proxy  upload + download  (Squid, its HTTPS CONNECT port)
#   TURN   upload + download  (coturn, UDP 3478, TCP/UDP 5349, relay ports)
#
# Proxy and TURN are accounted separately, and each direction has its own limit,
# so ten proxy connections from one address share one proxy allowance and several
# TURN allocations from that address share one TURN allowance.
#
# How it works
# ------------
# Download (server -> client) is shaped on the WAN interface with an HTB root
# qdisc: every client IP gets one HTB class per service, and a filter matches the
# service's source port into that class. Traffic that matches no class uses the
# default unlimited class, so unrelated traffic is untouched.
#
# Upload (client -> server) is shaped on an IFB device: only packets addressed to
# the proxy/TURN ports are mirrored there (unrelated traffic is never redirected),
# and on the IFB an HTB tree does the same per-source-IP classification.
#
# Linux tc cannot key a shaper by "any source address": HTB has no per-IP hash
# table. This script therefore refreshes its class table from the connections that
# actually exist (ss), every few seconds, from a small systemd service. The
# refresh is deliberately cheap: the socket table is read once per service (not
# once per direction) and parsed by awk, so the shell never walks it line by line,
# and an address that appears only adds its own rules instead of rebuilding the
# whole filter chain. The consequences are stated plainly:
#
#   * every service also has one fallback class, at exactly the per-IP rate, that
#     carries its traffic when the client address has no class yet. A limit is
#     therefore enforced from the first packet; within one refresh interval
#     (default 5s) the address moves to a class of its own. While several new
#     addresses are in the fallback class they share that one allowance;
#   * the number of tracked addresses is bounded (TC_MAX_CLIENTS), so a flood of
#     unique addresses cannot grow kernel state without limit;
#   * an address with no connection for TC_IDLE_SECONDS is forgotten.
#
# Two properties matter more than the cap itself for real-time voice:
#
#   * every class carries an active queue: `fq_codel` (per-flow fair queueing
#     with CoDel's 5 ms sojourn target) instead of HTB's default pfifo, whose
#     limit is the device txqueuelen. Without it a saturated class buffers a
#     second of audio and then drops a whole burst, which is exactly what cuts a
#     call out; with it the queue stays at a few milliseconds and loss, when the
#     cap is really exceeded, is spread over the offending flow instead of
#     arriving as a clump;
#   * client addresses are read from the conntrack table, not from the socket
#     table. coturn answers a UDP client from a socket bound to the relay port
#     that is shared by every client, and its per-allocation relay sockets talk
#     to the *peers*; `ss -uan` therefore cannot name a UDP TURN client at all.
#     The conntrack table can: one entry per client flow to 3478/5349. Without
#     conntrack every TURN client stays in the per-service fallback class, where
#     they all share one per-IP allowance — the reported "voice cuts out when
#     several people are on a call".
#
# Every tc command is checked: a rule that the kernel refuses aborts the apply
# instead of leaving a half-installed tree that looks active. `status` re-reads
# the kernel and requires the class *and* its classification filter to exist;
# `diagnose` prints the per-class queue state.
#
# Nothing here is per connection or per session, and no protocol is modified.
set -Eeuo pipefail

readonly PROGRAM="pishcord-relay-tc"
readonly DEFAULT_CONFIG="/etc/pishcord-relay/config.env"
readonly DEFAULT_TURN_CONF="/etc/pishcord-relay/turnserver.conf"

CONFIG="${PISHCORD_RELAY_CONFIG:-${DEFAULT_CONFIG}}"
TURN_CONF="${PISHCORD_RELAY_TURN_CONF:-${DEFAULT_TURN_CONF}}"
STATE_DIR="${PISHCORD_RELAY_TC_STATE:-/run/pishcord-relay-tc}"

# --- Defaults (mirrored in deploy/templates/config.env.tmpl) ---------------
PROXY_UPLOAD_LIMIT_MBIT=8
PROXY_DOWNLOAD_LIMIT_MBIT=8
TURN_UPLOAD_LIMIT_MBIT=16
TURN_DOWNLOAD_LIMIT_MBIT=16
TC_INTERFACE=""
TC_MAX_CLIENTS=512
TC_IDLE_SECONDS=60
TC_REFRESH_SECONDS=5
# Leaf queueing. Every class gets one; see the note in add_leaf_qdisc.
TC_AQM="auto"
TC_AQM_LIMIT=1000
TC_QUANTUM=1500
# Where client addresses come from: auto|conntrack|proc|ss.
TC_DISCOVERY="auto"
TC_TURN_SCAN_SECONDS=""

IFACE=""
IFB="pishcord-ifb"
# How often the TURN client table is re-read. The conntrack table is dumped with
# a kernel-side filter, so it is as cheap as the proxy's socket scan; the /proc
# table (used when the conntrack tool is absent) has to be read whole, so that
# backend reuses the previous list for a while and the fallback class keeps the
# limit in force in between.
TURN_SCAN_SECONDS=30
TURN_SCAN_SET=0
AQM_KIND=""
DISCOVERY_BACKEND=""
FILTER_CMD=add
readonly EGRESS_HANDLE=1
readonly INGRESS_HANDLE=2
readonly DEFAULT_CLASS=999
readonly MINOR_MAX=2047
# Reserved class ids for the fallback classes (see the header). They are never
# handed out by next_minor.
readonly HOLD_MINOR_PROXY=2040
readonly HOLD_MINOR_TURN=2041

PROXY_PORT=443
TURN_PORTS=(3478 5349)
RELAY_MIN=49152
RELAY_MAX=65535
RELAY_RANGE=0

DRY_RUN=0
VERBOSE=0
ONCE=0
COMMAND=""
FILTERS_READY=0
declare -A DISCOVER_AT=()
declare -A DISCOVER_LIST=()

# --- Output -----------------------------------------------------------------
if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != "dumb" ]]; then
	C_RESET=$'\033[0m' C_GREEN=$'\033[32m' C_RED=$'\033[31m' C_YELLOW=$'\033[33m'
else
	C_RESET="" C_GREEN="" C_RED="" C_YELLOW=""
fi

say() { printf '%s\n' "$*"; }
info() { printf '  %s\n' "$*"; }
ok() { printf '  %s✓%s %s\n' "${C_GREEN}" "${C_RESET}" "$*"; }
warn() { printf '  %s!%s %s\n' "${C_YELLOW}" "${C_RESET}" "$*" >&2; }
fail() { printf '  %s✗%s %s\n' "${C_RED}" "${C_RESET}" "$*" >&2; }
log() { if ((VERBOSE)); then printf '    %s\n' "$*" >&2; fi; }

usage() {
	cat <<EOF
${PROGRAM} - per-client-IP bandwidth limits for Pishcord Relay

Usage: ${PROGRAM} <command> [options]

  apply         Install the traffic-shaping rules for the configured limits
  refresh       Re-read the active client addresses and update the rules once
  watch         Keep refreshing (this is what the systemd service runs)
  status        Report the configured limits and whether they are active
  diagnose      Report per-class queue state, drops and the discovery source
  stop          Remove only the rules this program installed
  validate      Check the limit settings in ${CONFIG}

Options:
  --dry-run         Print the traffic-control commands instead of running them
  --once            With watch: refresh once and exit
  --config PATH     Configuration file (default ${CONFIG})
  --interface NAME  Network interface (default: detected from the default route)
  -v, --verbose     Print every command as it runs
  -h, --help        This help

Configuration (${DEFAULT_CONFIG}):
  PROXY_UPLOAD_LIMIT_MBIT=8     proxy upload per client IP, Mbit/s (0 disables)
  PROXY_DOWNLOAD_LIMIT_MBIT=8   proxy download per client IP, Mbit/s
  TURN_UPLOAD_LIMIT_MBIT=16     TURN upload per client IP, Mbit/s
  TURN_DOWNLOAD_LIMIT_MBIT=16   TURN download per client IP, Mbit/s
  TC_INTERFACE=                 interface to shape (empty: auto-detect)
  TC_MAX_CLIENTS=512            addresses tracked per service and direction
  TC_IDLE_SECONDS=60            forget an address after this long without a flow
  TC_REFRESH_SECONDS=5          how often the class table is refreshed
  TC_AQM=auto                   leaf queue: auto, fq_codel or pfifo
  TC_AQM_LIMIT=1000             leaf queue limit, packets
  TC_QUANTUM=1500               HTB quantum, bytes per round
  TC_DISCOVERY=auto             client addresses from auto, conntrack, proc or ss
  TC_TURN_SCAN_SECONDS=         how often the TURN table is re-read (0: automatic)

Limits are aggregate per client IP: extra connections from the same address
share the same allowance. The API's control traffic is not shaped.
EOF
}

die() {
	fail "$*"
	exit 1
}

# --- Configuration ----------------------------------------------------------
# config_get reads one KEY=value from the configuration file without sourcing it.
config_get() {
	local key="$1" line value=""
	[[ -r "${CONFIG}" ]] || return 0
	line="$(sed -n "s/^${key}=//p" "${CONFIG}" 2>/dev/null | tail -1)"
	value="${line%$'\r'}"
	if [[ ${#value} -ge 2 && ( ( ${value:0:1} == '"' && ${value: -1} == '"' ) || ( ${value:0:1} == "'" && ${value: -1} == "'" ) ) ]]; then
		value="${value:1:${#value}-2}"
	fi
	printf '%s' "${value}"
}

load_config() {
	local v
	v="$(config_get PROXY_UPLOAD_LIMIT_MBIT)"
	[[ -z "${v}" ]] || PROXY_UPLOAD_LIMIT_MBIT="${v}"
	v="$(config_get PROXY_DOWNLOAD_LIMIT_MBIT)"
	[[ -z "${v}" ]] || PROXY_DOWNLOAD_LIMIT_MBIT="${v}"
	v="$(config_get TURN_UPLOAD_LIMIT_MBIT)"
	[[ -z "${v}" ]] || TURN_UPLOAD_LIMIT_MBIT="${v}"
	v="$(config_get TURN_DOWNLOAD_LIMIT_MBIT)"
	[[ -z "${v}" ]] || TURN_DOWNLOAD_LIMIT_MBIT="${v}"
	v="$(config_get TC_INTERFACE)"
	[[ -z "${v}" ]] || TC_INTERFACE="${v}"
	v="$(config_get TC_MAX_CLIENTS)"
	[[ -z "${v}" ]] || TC_MAX_CLIENTS="${v}"
	v="$(config_get TC_IDLE_SECONDS)"
	[[ -z "${v}" ]] || TC_IDLE_SECONDS="${v}"
	v="$(config_get TC_REFRESH_SECONDS)"
	[[ -z "${v}" ]] || TC_REFRESH_SECONDS="${v}"
	v="$(config_get TC_AQM)"
	[[ -z "${v}" ]] || TC_AQM="${v}"
	v="$(config_get TC_AQM_LIMIT)"
	[[ -z "${v}" ]] || TC_AQM_LIMIT="${v}"
	v="$(config_get TC_QUANTUM)"
	[[ -z "${v}" ]] || TC_QUANTUM="${v}"
	v="$(config_get TC_DISCOVERY)"
	[[ -z "${v}" ]] || TC_DISCOVERY="${v}"
	v="$(config_get TC_TURN_SCAN_SECONDS)"
	if [[ -n "${v}" ]]; then
		TC_TURN_SCAN_SECONDS="${v}"
		TURN_SCAN_SET=1
	fi

	# The proxy port is the port in HTTPS_PROXY_URL, so a non-default proxy port
	# is shaped correctly without another setting.
	v="$(config_get HTTPS_PROXY_URL)"
	if [[ -n "${v}" ]]; then
		v="${v#*://}"
		v="${v%%/*}"
		v="${v##*:}"
		[[ "${v}" =~ ^[0-9]+$ ]] && PROXY_PORT="$((10#${v}))"
	fi

	if [[ -r "${TURN_CONF}" ]]; then
		local min max p
		min="$(sed -n 's/^min-port=//p' "${TURN_CONF}" | tail -1)"
		max="$(sed -n 's/^max-port=//p' "${TURN_CONF}" | tail -1)"
		[[ "${min}" =~ ^[0-9]+$ ]] && RELAY_MIN="$((10#${min}))"
		[[ "${max}" =~ ^[0-9]+$ ]] && RELAY_MAX="$((10#${max}))"
		p="$(sed -n 's/^listening-port=//p' "${TURN_CONF}" | tail -1)"
		[[ "${p}" =~ ^[0-9]+$ ]] && TURN_PORTS[0]="$((10#${p}))"
		p="$(sed -n 's/^tls-listening-port=//p' "${TURN_CONF}" | tail -1)"
		[[ "${p}" =~ ^[0-9]+$ ]] && TURN_PORTS[1]="$((10#${p}))"
	fi
	if ((RELAY_MIN <= RELAY_MAX)); then
		RELAY_RANGE=1
	fi
}

# limit_problem prints why VALUE is not a usable Mbit limit and returns 0;
# returns 1 when it is fine.
limit_problem() {
	local name="$1" value="$2"
	if [[ ! "${value}" =~ ^[0-9]{1,6}$ ]]; then
		printf '%s must be a whole number of Mbit/s (0 disables the limit), got %q' "${name}" "${value}"
		return 0
	fi
	if ((10#${value} > 100000)); then
		printf '%s must be at most 100000 Mbit/s, got %s' "${name}" "${value}"
		return 0
	fi
	return 1
}

# validate_config reports every unusable setting. It never changes anything.
validate_config() {
	local problems=0 name value reason
	for name in PROXY_UPLOAD_LIMIT_MBIT PROXY_DOWNLOAD_LIMIT_MBIT TURN_UPLOAD_LIMIT_MBIT TURN_DOWNLOAD_LIMIT_MBIT; do
		value="${!name}"
		if reason="$(limit_problem "${name}" "${value}")"; then
			fail "${reason}"
			problems=$((problems + 1))
		fi
	done
	if [[ ! "${TC_MAX_CLIENTS}" =~ ^[0-9]{1,6}$ ]] || ((10#${TC_MAX_CLIENTS} < 1 || 10#${TC_MAX_CLIENTS} > MINOR_MAX)); then
		fail "TC_MAX_CLIENTS must be between 1 and ${MINOR_MAX}, got ${TC_MAX_CLIENTS}"
		problems=$((problems + 1))
	fi
	if [[ ! "${TC_IDLE_SECONDS}" =~ ^[0-9]{1,6}$ ]] || ((10#${TC_IDLE_SECONDS} < 10)); then
		fail "TC_IDLE_SECONDS must be a whole number of at least 10, got ${TC_IDLE_SECONDS}"
		problems=$((problems + 1))
	fi
	if [[ ! "${TC_REFRESH_SECONDS}" =~ ^[0-9]{1,4}$ ]] || ((10#${TC_REFRESH_SECONDS} < 1)); then
		fail "TC_REFRESH_SECONDS must be a whole number of at least 1, got ${TC_REFRESH_SECONDS}"
		problems=$((problems + 1))
	fi
	if [[ -n "${TC_INTERFACE}" ]] && [[ ! "${TC_INTERFACE}" =~ ^[A-Za-z0-9_.:-]{1,15}$ ]]; then
		fail "TC_INTERFACE is not a valid interface name: ${TC_INTERFACE}"
		problems=$((problems + 1))
	fi
	case "${TC_AQM}" in
	auto | fq_codel | pfifo) ;;
	*)
		fail "TC_AQM must be auto, fq_codel or pfifo, got ${TC_AQM}"
		problems=$((problems + 1))
		;;
	esac
	if [[ ! "${TC_AQM_LIMIT}" =~ ^[0-9]{1,6}$ ]] || ((10#${TC_AQM_LIMIT} < 1 || 10#${TC_AQM_LIMIT} > 200000)); then
		fail "TC_AQM_LIMIT must be a packet count between 1 and 200000, got ${TC_AQM_LIMIT}"
		problems=$((problems + 1))
	fi
	if [[ ! "${TC_QUANTUM}" =~ ^[0-9]{1,6}$ ]] || ((10#${TC_QUANTUM} < 1500 || 10#${TC_QUANTUM} > 60000)); then
		fail "TC_QUANTUM must be between 1500 and 60000 bytes, got ${TC_QUANTUM}"
		problems=$((problems + 1))
	fi
	case "${TC_DISCOVERY}" in
	auto | conntrack | proc | ss) ;;
	*)
		fail "TC_DISCOVERY must be auto, conntrack, proc or ss, got ${TC_DISCOVERY}"
		problems=$((problems + 1))
		;;
	esac
	if [[ -n "${TC_TURN_SCAN_SECONDS}" ]] && { [[ ! "${TC_TURN_SCAN_SECONDS}" =~ ^[0-9]{1,5}$ ]] || ((10#${TC_TURN_SCAN_SECONDS} < 1)); }; then
		fail "TC_TURN_SCAN_SECONDS must be a whole number of at least 1, got ${TC_TURN_SCAN_SECONDS}"
		problems=$((problems + 1))
	fi
	((problems == 0))
}

# --- Interface and capabilities ---------------------------------------------
detect_interface() {
	if [[ -n "${TC_INTERFACE}" ]]; then
		IFACE="${TC_INTERFACE}"
	else
		IFACE="$(ip -o route get 1.1.1.1 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -1)"
		if [[ -z "${IFACE}" ]]; then
			IFACE="$(ip -o route show default 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -1)"
		fi
	fi
	[[ -n "${IFACE}" ]]
}

# link_rate_mbit is the interface's nominal speed, used only as the ceiling of
# the default class. When the driver does not report one, 10000 Mbit/s is used,
# which is above any small VPS uplink.
link_rate_mbit() {
	local speed=""
	[[ -r "/sys/class/net/${IFACE}/speed" ]] && speed="$(cat "/sys/class/net/${IFACE}/speed" 2>/dev/null || true)"
	if [[ "${speed}" =~ ^[0-9]+$ ]] && ((speed > 0)); then
		printf '%s' "${speed}"
		return 0
	fi
	printf '10000'
}

# burst_bytes keeps UDP voice usable: too small a bucket drops packets on
# micro-bursts. 50 ms of the limit, clamped, is comfortable for speech and still
# enforces the average rate.
burst_bytes() {
	local mbit="$1" bytes
	bytes=$((mbit * 1000000 / 8 / 20))
	((bytes < 16384)) && bytes=16384
	((bytes > 524288)) && bytes=524288
	printf '%s' "${bytes}"
}

# --- Leaf queueing ----------------------------------------------------------
# HTB gives a class with no child qdisc a plain pfifo, and that pfifo's limit is
# the interface's txqueuelen: about 1000 packets on a normal WAN device (up to
# ~1.5 s of standing queue at 8 Mbit/s, then a burst of tail drops) and only 32
# on an IFB device (a drop inside every ~24 ms of a 16 Mbit/s upload burst).
# A saturated class then delivers audio late and in clumps, which is what a
# voice call cannot survive. Every class therefore gets an active queue:
# fq_codel, which keeps the sojourn time near 5 ms and spreads unavoidable loss
# over the flow that causes it, or a bounded pfifo where fq_codel is missing.
aqm_configure() {
	case "${TC_AQM}" in
	pfifo) AQM_KIND=pfifo ;;
	*) AQM_KIND=fq_codel ;;
	esac
}

# leaf_handle gives a leaf qdisc a handle that cannot collide with the root
# handles (1:, 2:, ffff:). Handles are parsed as hexadecimal.
leaf_handle() { local n=$(($1 + 4096)); printf '%x:' "${n}"; }

# add_leaf_qdisc installs the queueing discipline below one HTB class. A kernel
# without sch_fq_codel is not an error: the warning says what was used instead
# and the cap itself is unaffected.
add_leaf_qdisc() { # dev classid minor
	local dev="$1" classid="$2" minor="$3" handle ok=1
	handle="$(leaf_handle "${minor}")"
	if [[ "${AQM_KIND}" == fq_codel ]]; then
		tc_try qdisc replace dev "${dev}" parent "${classid}" handle "${handle}" \
			fq_codel limit "${TC_AQM_LIMIT}" target 5ms interval 100ms ecn || ok=0
		if ((ok == 0)); then
			warn "fq_codel is unavailable on this kernel (sch_fq_codel); using a bounded pfifo queue instead. Voice jitter under load will be worse until it is available."
			AQM_KIND=pfifo
		fi
	fi
	if [[ "${AQM_KIND}" == pfifo ]]; then
		tc_try qdisc replace dev "${dev}" parent "${classid}" handle "${handle}" \
			pfifo limit "${TC_AQM_LIMIT}" || warn "could not install a leaf queue on ${dev} ${classid}"
	fi
}

# --- State ------------------------------------------------------------------
# The class table is persisted so a refresh (or a service restart) keeps the same
# class for the same address, and so expired addresses can be removed exactly.
#
# Format: <direction> <service> <minor> <ip> <last-seen-unix>
state_file() { printf '%s/classes' "${STATE_DIR}"; }

ensure_state_dir() {
	((DRY_RUN)) && return 0
	install -d -m 0700 -o root -g root "${STATE_DIR}"
}

declare -A ALLOC_MINOR=() # "dir|service|ip" -> minor
declare -A ALLOC_SEEN=()  # "dir|service|ip" -> last seen
declare -A USED_MINOR=()  # "dir|minor" -> "service|ip"
declare -A TRACKED=()     # dir -> number of tracked addresses

load_state() {
	local file dir service minor ip seen
	file="$(state_file)"
	[[ -r "${file}" ]] || return 0
	while read -r dir service minor ip seen; do
		[[ -n "${dir}" && -n "${service}" && -n "${minor}" && -n "${ip}" ]] || continue
		ALLOC_MINOR["${dir}|${service}|${ip}"]="${minor}"
		ALLOC_SEEN["${dir}|${service}|${ip}"]="${seen:-0}"
		USED_MINOR["${dir}|${minor}"]="${service}|${ip}"
		TRACKED["${dir}"]=$((${TRACKED["${dir}"]:-0} + 1))
	done <"${file}"
}

save_state() {
	((DRY_RUN)) && return 0
	local file key tmp dir service ip
	file="$(state_file)"
	tmp="${file}.new"
	: >"${tmp}"
	for key in "${!ALLOC_MINOR[@]}"; do
		IFS='|' read -r dir service ip <<<"${key}"
		printf '%s %s %s %s %s\n' "${dir}" "${service}" "${ALLOC_MINOR[${key}]}" "${ip}" "${ALLOC_SEEN[${key}]:-0}" >>"${tmp}"
	done
	mv "${tmp}" "${file}"
}

# next_minor allocates the lowest free class id for direction DIR and leaves it
# in NEXT_MINOR.
next_minor() {
	local dir="$1" n
	for ((n = 1; n <= MINOR_MAX; n++)); do
		((n == DEFAULT_CLASS || n == HOLD_MINOR_PROXY || n == HOLD_MINOR_TURN)) && continue
		[[ -z "${USED_MINOR["${dir}|${n}"]:-}" ]] || continue
		NEXT_MINOR="${n}"
		return 0
	done
	return 1
}

# --- Command execution ------------------------------------------------------
run_tc() {
	if ((DRY_RUN)); then
		printf 'tc %s\n' "$*"
		return 0
	fi
	log "tc $*"
	if ! tc "$@"; then
		fail "tc $* failed"
		# A refused rule must never be skipped silently: the remaining traffic
		# would flow unshaped while the tool claims the limits are installed.
		exit 1
	fi
}

# tc_try runs a tc command whose failure is reported to the caller instead of
# aborting the apply. It is used where a capability is optional (an AQM leaf, an
# incremental filter removal) and a fallback exists.
tc_try() {
	if ((DRY_RUN)); then
		printf 'tc %s\n' "$*"
		return 0
	fi
	log "tc $*"
	tc "$@" 2>/dev/null
}

# run_tc_try is for commands whose failure is harmless (removing a class or
# filter that a previous apply already removed).
run_tc_try() {
	tc_try "$@" || true
}

have_ifb() { ip link show "${IFB}" >/dev/null 2>&1; }

# own_qdisc reports whether the root qdisc of IFACE is the HTB tree this program
# installed. Anything else belongs to the administrator.
own_qdisc() {
	tc qdisc show dev "${IFACE}" 2>/dev/null | grep -q "qdisc htb ${EGRESS_HANDLE}: root"
}

current_root_qdisc() {
	tc qdisc show dev "${IFACE}" 2>/dev/null | sed -n 's/^qdisc \([^ ]*\) .*/\1/p' | head -1
}

previous_root_file() { printf '%s/previous-root' "${STATE_DIR}"; }

# --- Limits -----------------------------------------------------------------
# service_ports SERVICE fills SERVICE_PORTS with that service's local ports.
service_ports() {
	SERVICE_PORTS=()
	case "$1" in
	proxy) SERVICE_PORTS=("${PROXY_PORT}") ;;
	turn) SERVICE_PORTS=("${TURN_PORTS[@]}") ;;
	esac
}

# rate_of SERVICE DIR sets CRATE to the configured limit. It is a function that
# leaves its answer in a variable instead of printing it, because the refresh runs
# in a loop and a command substitution would fork a subshell for every lookup.
rate_of() {
	case "$1:$2" in
	proxy:upload) CRATE="${PROXY_UPLOAD_LIMIT_MBIT}" ;;
	proxy:download) CRATE="${PROXY_DOWNLOAD_LIMIT_MBIT}" ;;
	turn:upload) CRATE="${TURN_UPLOAD_LIMIT_MBIT}" ;;
	turn:download) CRATE="${TURN_DOWNLOAD_LIMIT_MBIT}" ;;
	esac
}

# shaping_directions SERVICE prints the directions that have a non-zero limit.
shaping_directions() {
	local dir out=""
	for dir in upload download; do
		rate_of "$1" "${dir}"
		if ((CRATE > 0)); then
			out+="${dir} "
		fi
	done
	printf '%s' "${out% }"
}

all_limits_disabled() {
	[[ -z "$(shaping_directions proxy)$(shaping_directions turn)" ]]
}

any_upload() { ((${PROXY_UPLOAD_LIMIT_MBIT} + ${TURN_UPLOAD_LIMIT_MBIT} > 0)); }
any_download() { ((${PROXY_DOWNLOAD_LIMIT_MBIT} + ${TURN_DOWNLOAD_LIMIT_MBIT} > 0)); }
any_limits() { any_upload || any_download; }

# hold_minor SERVICE is the reserved class id that carries that service's
# traffic until its client address has a class of its own.
hold_minor() {
	case "$1" in
	proxy) printf '%s' "${HOLD_MINOR_PROXY}" ;;
	turn) printf '%s' "${HOLD_MINOR_TURN}" ;;
	esac
}

# --- Device setup -----------------------------------------------------------
ensure_device() {
	local link previous
	link="$(link_rate_mbit)"

	if ! own_qdisc; then
		previous="$(current_root_qdisc)"
		# Only qdisc kinds that the kernel or the driver installs by default may
		# be replaced. A multiqueue NIC (AWS ENA, most 10G+ adapters) comes up
		# with `mq` at the root, which carries no configuration of its own; it is
		# recorded and put back on stop. Anything else is an administrator's
		# traffic-control tree and is never touched.
		case "${previous}" in
		"" | noqueue | pfifo | pfifo_fast | fq_codel | mq) ;;
		*)
			fail "the root qdisc on ${IFACE} is ${previous}, which this relay does not manage.
    Remove it or set TC_INTERFACE to another interface. Existing traffic-control
    configuration is never overwritten."
			return 1
			;;
		esac
		if ((DRY_RUN)); then
			printf '# record previous root qdisc: %s\n' "${previous:-none}"
		else
			ensure_state_dir
			printf '%s\n' "${previous:-none}" >"$(previous_root_file)"
		fi
		run_tc qdisc replace dev "${IFACE}" root handle "${EGRESS_HANDLE}:" htb default "${DEFAULT_CLASS}"
	fi
	run_tc class replace dev "${IFACE}" parent "${EGRESS_HANDLE}:" classid "${EGRESS_HANDLE}:${DEFAULT_CLASS}" \
		htb rate "${link}mbit" ceil "${link}mbit"

	any_limits || return 0

	# Fallback classes: relay traffic from an address that has no class yet is
	# still limited, because it lands in a class that carries exactly the
	# per-IP rate. That is what makes the limit apply from the first packet
	# instead of after the next refresh.
	local service rate
	for service in proxy turn; do
		rate_of "${service}" download
		rate="${CRATE}"
		((rate > 0)) || continue
		add_class download "${service}" "$(hold_minor "${service}")" "${rate}"
	done

	if any_upload; then
		# Upload shaping: mirror only relay traffic to an IFB device.
		if ! have_ifb; then
			if ((DRY_RUN)); then
				printf 'ip link add %s type ifb\n' "${IFB}"
				printf 'ip link set %s up\n' "${IFB}"
			else
				log "ip link add ${IFB} type ifb"
				ip link add "${IFB}" type ifb 2>/dev/null || true
				if ! have_ifb; then
					fail "could not create ${IFB}: upload shaping needs the ifb kernel module (modprobe ifb)"
					return 1
				fi
				ip link set "${IFB}" up
			fi
		fi
		# An IFB device comes up with txqueuelen 32. That number is the limit of
		# every pfifo HTB creates for a class, and it is also the queue that
		# re-injects shaped packets into the stack, so leave it large enough that
		# the interface stops accepting instead of dropping. The leaf qdiscs are
		# what actually bound the queue now.
		if ((DRY_RUN == 0)); then
			ip link set "${IFB}" txqueuelen 1000 2>/dev/null || warn "could not raise the txqueuelen of ${IFB}"
		else
			printf 'ip link set %s txqueuelen 1000\n' "${IFB}"
		fi
		run_tc qdisc replace dev "${IFB}" root handle "${INGRESS_HANDLE}:" htb default "${DEFAULT_CLASS}"
		run_tc class replace dev "${IFB}" parent "${INGRESS_HANDLE}:" classid "${INGRESS_HANDLE}:${DEFAULT_CLASS}" \
			htb rate "${link}mbit" ceil "${link}mbit"

		for service in proxy turn; do
			rate_of "${service}" upload
			rate="${CRATE}"
			((rate > 0)) || continue
			add_class upload "${service}" "$(hold_minor "${service}")" "${rate}"
		done

		if ((DRY_RUN)); then
			printf 'tc qdisc replace dev %s handle ffff: ingress\n' "${IFACE}"
			printf 'tc filter del dev %s parent ffff:\n' "${IFACE}"
		else
			tc qdisc replace dev "${IFACE}" handle ffff: ingress 2>/dev/null || true
			tc filter del dev "${IFACE}" parent ffff: 2>/dev/null || true
		fi
		for service in proxy turn; do
			rate_of "${service}" upload
			rate="${CRATE}"
			((rate > 0)) || continue
			add_ingress_mirror "${service}"
		done
	fi
	return 0
}

reset_filters() {
	((DRY_RUN)) && return 0
	tc filter del dev "${IFACE}" parent "${EGRESS_HANDLE}:" 2>/dev/null || true
	if have_ifb; then
		tc filter del dev "${IFB}" parent "${INGRESS_HANDLE}:" 2>/dev/null || true
	fi
}

# add_ingress_mirror SERVICE copies that service's upload packets to the IFB
# device. Only the relay's own ports are mirrored; the rest of the traffic keeps
# its normal path.
add_ingress_mirror() {
	local service="$1" p
	local -a ports
	service_ports "${service}"
	ports=("${SERVICE_PORTS[@]}")
	for p in "${ports[@]}"; do
		run_tc filter add dev "${IFACE}" parent ffff: protocol ip prio 1 u32 \
			match ip dport "${p}" 0xffff action mirred egress redirect dev "${IFB}"
		run_tc filter add dev "${IFACE}" parent ffff: protocol ipv6 prio 1 u32 \
			match ip6 dport "${p}" 0xffff action mirred egress redirect dev "${IFB}"
	done
	# The coturn relay range is deliberately NOT mirrored. On the WAN interface a
	# packet arriving for a port in 49152-65535 is what a *peer* sends to the
	# relay, or a reply to one of the host's own outbound connections; it is never
	# what a client uploads (a TURN client sends to 3478/5349). Mirroring it put
	# every one of those packets through an IFB round trip for nothing, and where
	# the source happened to be a shaped address it was billed as that client's
	# upload. Per-address download filters still cover the relay range.
}

add_class() {
	local dir="$1" service="$2" minor="$3" rate="$4" dev parent classid burst
	if [[ "${dir}" == "download" ]]; then
		dev="${IFACE}"
		parent="${EGRESS_HANDLE}:"
	else
		dev="${IFB}"
		parent="${INGRESS_HANDLE}:"
	fi
	classid="${parent}${minor}"
	burst="$(burst_bytes "${rate}")"
	# quantum is set explicitly: HTB otherwise uses rate/r2q, which at 8-16 Mbit
	# is 100-200 kB per round — about 60-130 voice packets served from one class
	# before the scheduler looks at the next one, i.e. exactly the clumping this
	# script must avoid. 1500 bytes keeps rounds to a packet.
	run_tc class replace dev "${dev}" parent "${parent}" classid "${classid}" \
		htb rate "${rate}mbit" ceil "${rate}mbit" burst "${burst}" cburst "${burst}" \
		quantum "${TC_QUANTUM}"
	# The class is only a token bucket until something queues below it; without
	# this it is a 1000-packet (WAN) or 32-packet (IFB) pfifo.
	add_leaf_qdisc "${dev}" "${classid}" "${minor}"
}

# put_filter installs or removes one classifier. FILTER_CMD selects which, so the
# add and delete paths use the same match specification and cannot drift apart.
put_filter() { # dev ... (rest of a tc filter spec)
	if [[ "${FILTER_CMD}" == "del" ]]; then
		tc_try filter del "$@" || true
		return 0
	fi
	run_tc filter add "$@"
}

# filters_for DEV PARENT CLASSID prints how many classifiers still point at a
# class. tc deletes matches silently, so removals are checked instead of trusted.
filters_for() { # dev parent classid
	if ((DRY_RUN)); then
		printf '0'
		return 0
	fi
	local count
	count="$(tc filter show dev "$1" parent "$2" 2>/dev/null | grep -c "flowid $3" || true)"
	printf '%s' "${count:-0}"
}

# add_filters DIR SERVICE MINOR IP steers that address's relay traffic into its
# class: one filter per service port, plus one for the coturn relay range.
add_filters() {
	local dir="$1" service="$2" minor="$3" ip="$4" p handle prefix dport
	local -a ports
	service_ports "${service}"
	ports=("${SERVICE_PORTS[@]}")

	local is6=0
	[[ "${ip}" == *:* ]] && is6=1

	if ((is6)); then
		prefix="ip6"
		handle="3"
	else
		prefix="ip"
		handle="1"
	fi

	local dev parent key
	if [[ "${dir}" == "download" ]]; then
		dev="${IFACE}"
		parent="${EGRESS_HANDLE}:"
		key="dst"
		dport=0
	else
		dev="${IFB}"
		parent="${INGRESS_HANDLE}:"
		key="src"
		dport=1
	fi

	local port_field="sport"
	((dport)) && port_field="dport"

	for p in "${ports[@]}"; do
		if ((is6)); then
			put_filter dev "${dev}" parent "${parent}" protocol ipv6 prio "${handle}" u32 \
				match "${prefix}" "${key}" "${ip}/128" match "${prefix}" "${port_field}" "${p}" 0xffff \
				flowid "${parent}${minor}"
		else
			put_filter dev "${dev}" parent "${parent}" protocol ip prio "${handle}" u32 \
				match "${prefix}" "${key}" "${ip}/32" match "${prefix}" "${port_field}" "${p}" 0xffff \
				flowid "${parent}${minor}"
		fi
	done
	if ((RELAY_RANGE)) && [[ "${service}" == "turn" ]]; then
		if ((is6)); then
			put_filter dev "${dev}" parent "${parent}" protocol ipv6 prio 3 u32 \
				match ip6 "${key}" "${ip}/128" match ip6 "${port_field}" 0xc000 0xc000 \
				flowid "${parent}${minor}"
		else
			put_filter dev "${dev}" parent "${parent}" protocol ip prio 1 u32 \
				match ip "${key}" "${ip}/32" match ip "${port_field}" 0xc000 0xc000 \
				flowid "${parent}${minor}"
		fi
	fi
}

# del_filters DIR SERVICE MINOR IP removes exactly that address's classifiers,
# leaving everybody else's in place. `reset_filters` is only the fallback: while
# the chain is empty every packet takes the unlimited default class, so it is not
# used for an ordinary address expiring any more.
del_filters() { # dir service minor ip
	FILTER_CMD=del
	add_filters "$@"
	FILTER_CMD=add
}

# add_hold_filters DIR SERVICE sends the service's relay traffic that matches no
# client address into its fallback class. Per-address filters run first
# (prio 1 for IPv4, 3 for IPv6), so an address with its own class, and therefore
# its own rate, is never affected by the fallback.
add_hold_filters() {
	local dir="$1" service="$2" p port_field dev parent classid
	local -a ports
	service_ports "${service}"
	ports=("${SERVICE_PORTS[@]}")
	if [[ "${dir}" == "download" ]]; then
		dev="${IFACE}"
		parent="${EGRESS_HANDLE}:"
		port_field="sport"
	else
		dev="${IFB}"
		parent="${INGRESS_HANDLE}:"
		port_field="dport"
	fi
	classid="${parent}$(hold_minor "${service}")"
	for p in "${ports[@]}"; do
		put_filter dev "${dev}" parent "${parent}" protocol ip prio 2 u32 \
			match ip "${port_field}" "${p}" 0xffff flowid "${classid}"
		put_filter dev "${dev}" parent "${parent}" protocol ipv6 prio 4 u32 \
			match ip6 "${port_field}" "${p}" 0xffff flowid "${classid}"
	done
	# The coturn relay range is deliberately not part of the fallback: on the
	# WAN interface a source port in 49152-65535 is also how the host's own
	# outbound connections look, and without a client address to match, the
	# server's own traffic (update downloads, profile fetches) would be limited
	# as TURN traffic. Those packets get their per-address class on the next
	# refresh instead.
}

# --- Client discovery -------------------------------------------------------
# A client address is the source address of a flow to the relay's own listening
# ports. Two sources can name those flows:
#
#   conntrack  one entry per client flow, in both directions. Kernel-filtered by
#              protocol and destination port (ctnetlink), so the cost depends on
#              the relay's own traffic, not on the size of the whole table. This
#              is the only source that can name a UDP TURN client: coturn answers
#              it from the shared listener socket bound to 3478, and its
#              per-allocation relay sockets only ever talk to the *peers*.
#   ss         the socket table. Exact for accepted TCP connections (the proxy,
#              TURN over TLS); it cannot see a UDP TURN client at all, because
#              such a flow lives on a 0.0.0.0:3478 listener whose peer address is
#              never recorded. With this source TURN classes only appear for TLS
#              clients, and `status` says so.
#
# The table is parsed by awk and only the client addresses reach the shell, so a
# refresh costs the same whether five or five hundred addresses are shaped.
#
# discover_clients SERVICE prints the distinct client addresses using it. No
# packet contents are read; only flow endpoints. It runs once per service per
# refresh (both directions use the same list).
ss_peers() {
	awk '
		{
			ip = $5
			sub(/:[^:]*$/, "", ip)
			gsub(/^\[|\]$/, "", ip)
			sub(/%.*$/, "", ip)
			if (ip == "" || ip == "*" || ip in seen) next
			seen[ip] = 1
			print ip
		}'
}

# conntrack_peers keeps the client address of every entry whose destination port
# is one of PORTS. The first src= of a conntrack line is the original direction,
# i.e. the client; the reply tuple that follows is ignored.
conntrack_peers() { # PORTS
	awk -v ports="$1" '
		BEGIN {
			n = split(ports, a, " ")
			for (i = 1; i <= n; i++) if (a[i] != "") want[a[i]] = 1
		}
		{
			matched = 0
			for (i = 1; i <= NF; i++)
				if ($i ~ /^dport=/ && (substr($i, 7) in want)) { matched = 1; break }
			if (!matched) next
			ip = ""
			for (i = 1; i <= NF; i++) if ($i ~ /^src=/) { ip = substr($i, 5); break }
			if (ip == "" || ip in seen) next
			seen[ip] = 1
			print ip
		}'
}

conntrack_file() {
	if [[ -r /proc/net/nf_conntrack ]]; then
		printf '%s' /proc/net/nf_conntrack
	elif [[ -r /proc/net/ip_conntrack ]]; then
		printf '%s' /proc/net/ip_conntrack
	fi
}

# detect_discovery picks the source once per process. `auto` prefers the
# conntrack tool (cheap kernel-filtered dumps), then the /proc table, and only
# then the socket table, which cannot see UDP TURN clients.
detect_discovery() {
	case "${TC_DISCOVERY:-auto}" in
	conntrack | proc | ss) DISCOVERY_BACKEND="${TC_DISCOVERY}" ;;
	*)
		if command -v conntrack >/dev/null 2>&1; then
			DISCOVERY_BACKEND=conntrack
		elif [[ -n "$(conntrack_file)" ]]; then
			DISCOVERY_BACKEND=proc
		else
			DISCOVERY_BACKEND=ss
		fi
		;;
	esac
	# The /proc table has to be read whole, so it is scanned less often; a
	# kernel-filtered conntrack dump is cheap enough to do on every refresh.
	if ((TURN_SCAN_SET == 0)); then
		if [[ "${DISCOVERY_BACKEND}" == proc ]]; then
			TURN_SCAN_SECONDS=30
		else
			TURN_SCAN_SECONDS="${TC_REFRESH_SECONDS}"
		fi
	fi
}

# discover_turn_clients prints the client addresses of TURN flows. Both listener
# protocols are covered: UDP is the primary transport and TCP the TLS fallback.
discover_turn_clients() {
	local proto port file
	if [[ "${DISCOVERY_BACKEND}" == conntrack ]]; then
		for port in "${TURN_PORTS[@]}"; do
			for proto in udp tcp; do
				conntrack -L -p "${proto}" --dport "${port}" 2>/dev/null || true
			done
		done | conntrack_peers "${TURN_PORTS[*]}"
		return 0
	fi
	if [[ "${DISCOVERY_BACKEND}" == proc ]]; then
		file="$(conntrack_file)"
		[[ -n "${file}" ]] || return 0
		conntrack_peers "${TURN_PORTS[*]}" <"${file}" 2>/dev/null || true
		return 0
	fi
	# No conntrack: only accepted TCP connections can name a TURN client.
	ss -Htn state established "( sport = :${TURN_PORTS[0]} or sport = :${TURN_PORTS[1]} )" 2>/dev/null | ss_peers
}

discover_clients() {
	local service="$1"
	if [[ -n "${PISHCORD_RELAY_TC_FAKE_CLIENTS:-}" ]]; then
		# Test hook: a comma separated list stands in for live connections.
		printf '%s\n' "${PISHCORD_RELAY_TC_FAKE_CLIENTS}" | tr ',' '\n'
		return 0
	fi

	if [[ "${service}" == "proxy" ]]; then
		# A connection accepted by Squid is in the socket table with the client
		# as its peer. (conntrack is not used here: it would also name this
		# host's own outbound HTTPS flows, whose destination port is 443 too.)
		ss -Htn state established "( sport = :${PROXY_PORT} )" 2>/dev/null | ss_peers
		return 0
	fi

	discover_turn_clients
}

# clients_for SERVICE NOW sets CLIENTS_OUT to that service's client addresses.
# The proxy table is read on every refresh (its filtered scan is a few
# milliseconds); the TURN table is read at most every TURN_SCAN_SECONDS. The
# answer is left in a variable rather than printed, so the scan times are
# remembered by the long-running process and not by a throwaway subshell.
clients_for() {
	local service="$1" now="$2" last
	if [[ -n "${PISHCORD_RELAY_TC_FAKE_CLIENTS:-}" ]]; then
		CLIENTS_OUT="$(discover_clients "${service}")"
		return 0
	fi
	last="${DISCOVER_AT["${service}"]:-}"
	if [[ "${service}" == "proxy" ]] || [[ -z "${last}" ]] || ((last + TURN_SCAN_SECONDS <= now)); then
		DISCOVER_LIST["${service}"]="$(discover_clients "${service}")"
		DISCOVER_AT["${service}"]="${now}"
	fi
	CLIENTS_OUT="${DISCOVER_LIST["${service}"]:-}"
}

# --- Apply and refresh ------------------------------------------------------
apply_rules() {
	ensure_device || return 1
	refresh_rules
}

refresh_rules() {
	local now="${EPOCHSECONDS:-0}"
	((now > 0)) || now="$(date +%s)"
	local key dir service ip minor rate clients wanted seen_any left
	local filters_dev filters_parent changed=0 rebuild=0 deleted=0 snapshot edir
	local -A current=()

	for service in proxy turn; do
		# One socket scan per service: the two directions shape the same
		# client addresses.
		wanted=0
		for dir in upload download; do
			rate_of "${service}" "${dir}"
			((CRATE > 0)) && wanted=1
		done
		((wanted)) || continue
		clients_for "${service}" "${now}"
		clients="${CLIENTS_OUT}"

		for dir in upload download; do
			rate_of "${service}" "${dir}"
			rate="${CRATE}"
			((rate > 0)) || continue

			while read -r ip; do
				[[ -n "${ip}" ]] || continue
				key="${dir}|${service}|${ip}"
				[[ -n "${current["${key}"]:-}" ]] && continue

				if [[ -z "${ALLOC_MINOR["${key}"]:-}" ]]; then
					# A new address is only tracked while the table has room.
					if ((${TRACKED["${dir}"]:-0} >= TC_MAX_CLIENTS)); then
						warn "${service} ${dir}: ${TC_MAX_CLIENTS} client addresses are already tracked; ${ip} is not limited. Raise TC_MAX_CLIENTS or reduce the number of active addresses."
						continue
					fi
					if ! next_minor "${dir}"; then
						warn "no free class left for ${service} ${dir}; ${ip} is not limited"
						continue
					fi
					minor="${NEXT_MINOR}"
					ALLOC_MINOR["${key}"]="${minor}"
					USED_MINOR["${dir}|${minor}"]="${service}|${ip}"
					TRACKED["${dir}"]=$((${TRACKED["${dir}"]:-0} + 1))
					add_class "${dir}" "${service}" "${minor}" "${rate}"
					# An address that appears only gets its own rules; the filter
					# chain is not rebuilt for it.
					if ((FILTERS_READY)); then
						add_filters "${dir}" "${service}" "${minor}" "${ip}"
					fi
					changed=1
				fi
				current["${key}"]=1
				ALLOC_SEEN["${key}"]="${now}"
			done <<<"${clients}"
		done
	done

	# Forget addresses that have been gone longer than TC_IDLE_SECONDS. Their
	# classifiers are removed on their own; only a removal the kernel does not
	# confirm (or a handle left over from an older version) falls back to
	# rebuilding the whole chain, because that leaves every packet unrouted to a
	# shaped class for the moment it takes.
	for key in "${!ALLOC_MINOR[@]}"; do
		[[ -n "${current["${key}"]:-}" ]] && continue
		IFS='|' read -r dir service ip <<<"${key}"
		minor="${ALLOC_MINOR["${key}"]}"
		seen_any="${ALLOC_SEEN["${key}"]:-0}"
		((now - seen_any < TC_IDLE_SECONDS)) && continue
		if [[ "${dir}" == "download" ]]; then
			run_tc_try class del dev "${IFACE}" classid "${EGRESS_HANDLE}:${minor}"
			filters_dev="${IFACE}"
			filters_parent="${EGRESS_HANDLE}:"
		else
			run_tc_try class del dev "${IFB}" classid "${INGRESS_HANDLE}:${minor}"
			filters_dev="${IFB}"
			filters_parent="${INGRESS_HANDLE}:"
		fi
		del_filters "${dir}" "${service}" "${minor}" "${ip}"
		left="$(filters_for "${filters_dev}" "${filters_parent}" "${filters_parent}${minor}")"
		if [[ "${left}" != "0" ]]; then
			log "classifiers for ${ip} could not be removed one by one; rebuilding the chain"
			rebuild=1
		fi
		unset "ALLOC_MINOR[${key}]" "ALLOC_SEEN[${key}]" "USED_MINOR[\"${dir}|${minor}\"]"
		TRACKED["${dir}"]=$((${TRACKED["${dir}"]:-1} - 1))
		changed=1
		deleted=1
	done

	# Removing one address's classifiers must not remove anybody else's. One
	# snapshot per device proves it; anything unexpected rebuilds the chain.
	if ((deleted && DRY_RUN == 0)); then
		for dir in upload download; do
			if [[ "${dir}" == "upload" ]]; then
				any_upload || continue
				filters_dev="${IFB}"
				filters_parent="${INGRESS_HANDLE}:"
			else
				any_download || continue
				filters_dev="${IFACE}"
				filters_parent="${EGRESS_HANDLE}:"
			fi
			snapshot="$(tc filter show dev "${filters_dev}" parent "${filters_parent}" 2>/dev/null || true)"
			for key in "${!ALLOC_MINOR[@]}"; do
				IFS='|' read -r edir _ _ <<<"${key}"
				[[ "${edir}" == "${dir}" ]] || continue
				if ! filter_has "${snapshot}" "${filters_parent}${ALLOC_MINOR[${key}]}"; then
					log "classifiers of another address disappeared with ${ip}; rebuilding the chain"
					rebuild=1
					break 2
				fi
			done
		done
	fi

	# Filters are fully derived from the class table: rebuild them after a
	# removal or the first time this process runs (which also clears duplicates
	# left by an earlier run). Additions were installed as they happened.
	if ((rebuild || !FILTERS_READY)); then
		reset_filters
		local hold_service hold_dir
		for hold_service in proxy turn; do
			for hold_dir in upload download; do
				rate_of "${hold_service}" "${hold_dir}"
				((CRATE > 0)) || continue
				add_hold_filters "${hold_dir}" "${hold_service}"
			done
		done
		for key in "${!ALLOC_MINOR[@]}"; do
			IFS='|' read -r dir service ip <<<"${key}"
			add_filters "${dir}" "${service}" "${ALLOC_MINOR["${key}"]}" "${ip}"
		done
		FILTERS_READY=1
		changed=1
	fi
	if ((changed)); then
		save_state
	fi
	return 0
}

# --- Status -----------------------------------------------------------------
# status prints key=value lines and exits 0 only when every configured limit is
# actually installed on the interface.
filter_has() { # filter-text classid
	grep -Eq "flowid ${2}([[:space:]]|$)" <<<"$1"
}

class_line() { # class-text parent minor
	grep -E "class htb ${2}${3}([[:space:]]|$)" <<<"$1" | head -1 || true
}

rate_mbit_of() { # class line -> rate in Mbit/s
	local value unit v
	v="$(sed -n 's/.*rate \([0-9][0-9]*\)\([KMGT]\?\)bit.*/\1 \2/p' <<<"$1" | head -1)"
	[[ -n "${v}" ]] || return 0
	value="${v%% *}"
	unit="${v##* }"
	case "${unit}" in
	M | "") ;;
	K) value=$((value / 1000)) ;;
	G) value=$((value * 1000)) ;;
	*) value=0 ;;
	esac
	printf '%s' "${value}"
}

status() {
	local problems=0 egress_ok=0 ingress_ok=0 mirror_ok=0 needed=0 need_up=0
	printf 'interface=%s\n' "${IFACE:-unknown}"
	printf 'proxy_upload_mbit=%s\n' "${PROXY_UPLOAD_LIMIT_MBIT}"
	printf 'proxy_download_mbit=%s\n' "${PROXY_DOWNLOAD_LIMIT_MBIT}"
	printf 'turn_upload_mbit=%s\n' "${TURN_UPLOAD_LIMIT_MBIT}"
	printf 'turn_download_mbit=%s\n' "${TURN_DOWNLOAD_LIMIT_MBIT}"
	printf 'max_clients=%s\n' "${TC_MAX_CLIENTS}"
	printf 'discovery=%s\n' "${DISCOVERY_BACKEND:-ss}"
	printf 'aqm=%s\n' "${AQM_KIND:-fq_codel}"
	any_limits && needed=1
	printf 'limits_configured=%s\n' "${needed}"
	if ((needed)) && [[ "${DISCOVERY_BACKEND:-ss}" == "ss" ]] &&
		{ ((TURN_UPLOAD_LIMIT_MBIT > 0)) || ((TURN_DOWNLOAD_LIMIT_MBIT > 0)); }; then
		warn "no conntrack table is readable, so coturn's UDP clients cannot be discovered and share the per-service fallback class. Install the conntrack tool (or load the nf_conntrack module) for the TURN limits to apply per client IP."
	fi

	if ! command -v tc >/dev/null 2>&1; then
		printf 'shaping=unavailable\n'
		fail "tc is not installed; no bandwidth limit is being enforced"
		return 1
	fi
	if [[ -z "${IFACE}" ]]; then
		printf 'shaping=inactive\n'
		fail "no network interface detected; no bandwidth limit is being enforced"
		return 1
	fi
	if ((needed == 0)); then
		printf 'shaping=disabled\n'
		return 0
	fi

	any_upload && need_up=1

	if own_qdisc; then
		egress_ok=1
		printf 'egress_qdisc=htb %s:\n' "${EGRESS_HANDLE}"
	else
		printf 'egress_qdisc=%s\n' "$(current_root_qdisc)"
	fi
	if have_ifb && tc qdisc show dev "${IFB}" 2>/dev/null | grep -q "qdisc htb ${INGRESS_HANDLE}: root"; then
		ingress_ok=1
		printf 'ingress_qdisc=htb %s:,%s\n' "${INGRESS_HANDLE}" "${IFB}"
	else
		printf 'ingress_qdisc=missing\n'
	fi

	# Read the kernel once and answer every question from that snapshot.
	local egress_classes="" ingress_classes="" egress_filters="" ingress_filters="" ingress_mirror=""
	egress_classes="$(tc class show dev "${IFACE}" 2>/dev/null || true)"
	egress_filters="$(tc filter show dev "${IFACE}" parent "${EGRESS_HANDLE}:" 2>/dev/null || true)"
	if ((ingress_ok)); then
		ingress_classes="$(tc class show dev "${IFB}" 2>/dev/null || true)"
		ingress_filters="$(tc filter show dev "${IFB}" parent "${INGRESS_HANDLE}:" 2>/dev/null || true)"
	fi
	ingress_mirror="$(tc filter show dev "${IFACE}" parent ffff: 2>/dev/null || true)"

	if ((need_up)); then
		# tc prints the action as "mirred (Egress Redirect to device <dev>)".
		if ((ingress_ok)) && grep -qi "redirect to device ${IFB}\|mirror to device ${IFB}" <<<"${ingress_mirror}"; then
			mirror_ok=1
			printf 'ingress_redirect=%s\n' "${IFB}"
		else
			printf 'ingress_redirect=missing\n'
		fi
	fi

	# Every configured limit must be backed by a class *and* the filter that
	# steers traffic into it. A class alone shapes nothing.
	local service dir rate minor line classid classes filters parent active_rate
	for service in proxy turn; do
		for dir in upload download; do
			rate_of "${service}" "${dir}"
			rate="${CRATE}"
			((rate > 0)) || continue
			minor="$(hold_minor "${service}")"
			if [[ "${dir}" == "download" ]]; then
				classes="${egress_classes}"
				filters="${egress_filters}"
				parent="${EGRESS_HANDLE}:"
			else
				classes="${ingress_classes}"
				filters="${ingress_filters}"
				parent="${INGRESS_HANDLE}:"
			fi
			classid="${parent}${minor}"
			line="$(class_line "${classes}" "${parent}" "${minor}")"
			if [[ -z "${line}" ]]; then
				printf 'missing_fallback_class=%s,%s\n' "${dir}" "${service}"
				problems=$((problems + 1))
			else
				active_rate="$(rate_mbit_of "${line}")"
				if [[ -n "${active_rate}" ]] && ((active_rate != rate)); then
					printf 'fallback_rate_mismatch=%s,%s,%s,%s\n' "${dir}" "${service}" "${rate}" "${active_rate}"
					problems=$((problems + 1))
				fi
			fi
			if ! filter_has "${filters}" "${classid}"; then
				printf 'missing_fallback_filter=%s,%s\n' "${dir}" "${service}"
				problems=$((problems + 1))
			fi
		done
	done

	load_state
	local key ip checked
	local -A reported=()
	for key in "${!ALLOC_MINOR[@]}"; do
		IFS='|' read -r dir service ip <<<"${key}"
		rate_of "${service}" "${dir}"
		rate="${CRATE}"
		((rate > 0)) || continue
		minor="${ALLOC_MINOR[${key}]}"
		if [[ "${dir}" == "download" ]]; then
			classes="${egress_classes}"
			filters="${egress_filters}"
			parent="${EGRESS_HANDLE}:"
		else
			classes="${ingress_classes}"
			filters="${ingress_filters}"
			parent="${INGRESS_HANDLE}:"
		fi
		line="$(class_line "${classes}" "${parent}" "${minor}")"
		if [[ -z "${line}" ]]; then
			printf 'missing_class=%s,%s,%s\n' "${dir}" "${service}" "${ip}"
			problems=$((problems + 1))
			continue
		fi
		if ! filter_has "${filters}" "${parent}${minor}"; then
			printf 'missing_filter=%s,%s,%s\n' "${dir}" "${service}" "${ip}"
			problems=$((problems + 1))
			continue
		fi
		checked="${dir},${service}"
		[[ -n "${reported[${checked}]:-}" ]] && continue
		# The rate the kernel actually holds for this class, in Mbit/s, so a
		# configuration change that was never applied is visible.
		active_rate="$(rate_mbit_of "${line}")"
		if [[ -z "${active_rate}" ]]; then
			printf 'rate_unreadable=%s,%s\n' "${dir}" "${service}"
			continue
		fi
		reported[${checked}]=1
		printf 'active_rate=%s,%s,%s\n' "${dir}" "${service}" "${active_rate}"
		if ((active_rate != rate)); then
			printf 'rate_mismatch=%s,%s,%s,%s\n' "${dir}" "${service}" "${rate}" "${active_rate}"
			problems=$((problems + 1))
		fi
	done

	if ((problems == 0 && egress_ok == 1)); then
		if ((need_up)) && ((ingress_ok == 0 || mirror_ok == 0)); then
			printf 'shaping=partial\n'
			fail "upload limits are configured but the ingress shaper is not active"
			return 1
		fi
		printf 'shaping=active\n'
		printf 'shaped_addresses=%s\n' "${#ALLOC_MINOR[@]}"
		return 0
	fi
	printf 'shaping=inactive\n'
	if ((egress_ok == 0)); then
		fail "the root qdisc on ${IFACE} is $(current_root_qdisc); this relay's shaping tree is not installed, so no bandwidth limit is enforced"
	elif ((problems > 0)); then
		fail "bandwidth limits are configured but are not fully enforced on ${IFACE} (${problems} missing or wrong rules); see the lines above"
	else
		fail "upload limits are configured but relay upload traffic is not reaching the shaper on ${IFACE}"
	fi
	return 1
}

# --- Diagnose ---------------------------------------------------------------
# A class that drops packets is invisible in the ordinary logs: the call just
# sounds bad. diagnose prints the queue state of every class so the loss can be
# attributed, and counts the allocations coturn refused for bandwidth reasons.
diagnose_device() { # dev title
	local dev="$1" title="$2"
	printf '\n%s (%s)\n' "${title}" "${dev}"
	if ! tc qdisc show dev "${dev}" >/dev/null 2>&1; then
		printf '  no traffic-control information\n'
		return 0
	fi
	printf '  queues:\n'
	tc qdisc show dev "${dev}" 2>/dev/null | sed -e 's/^qdisc /    /' -e 's/qdisc /  qdisc /g' | head -20
	printf '  classes (sent / dropped / overlimits / backlog):\n'
	tc -s class show dev "${dev}" 2>/dev/null | awk '
		/^class htb/ { cls = $3; sent = ""; next }
		$1 == "Sent" { sent = $2 " " $3 " " $4 " pkt (dropped " $7 " overlimits " $10 ")"; next }
		$1 == "backlog" { printf "    %-10s %s backlog %s\n", cls, sent, $2; next }
	' | head -40
}

diagnose() {
	local dev turn_log
	status || true
	printf '\nturn_scan_seconds=%s\n' "${TURN_SCAN_SECONDS}"
	case "${DISCOVERY_BACKEND:-ss}" in
	conntrack) ok "coturn clients are discovered from the conntrack table, UDP and TLS" ;;
	proc) ok "coturn clients are discovered from the kernel conntrack table (no conntrack tool)" ;;
	*) warn "only the socket table is available: UDP TURN clients cannot be discovered and share the fallback class" ;;
	esac

	if [[ -n "${IFACE}" ]]; then
		diagnose_device "${IFACE}" "download (shaped on the WAN interface)"
	fi
	if have_ifb; then
		diagnose_device "${IFB}" "upload (shaped on the IFB device)"
	fi

	turn_log="$(sed -n 's/^log-file=//p' "${TURN_CONF}" 2>/dev/null | tail -1)"
	printf '\ncoturn:\n'
	if [[ -n "${turn_log}" && -r "${turn_log}" ]]; then
		printf '  error 486 (allocation bandwidth quota reached, whole log): %s\n' \
			"$(grep -c 'error 486' "${turn_log}" 2>/dev/null || true)"
	else
		printf '  %s is not readable; check coturn\047s log directly\n' "${turn_log:-turnserver.log}"
	fi
	printf '  max-bps and bps-capacity are in %s\n' "${TURN_CONF}"
}

# --- Stop -------------------------------------------------------------------
stop_shaping() {
	detect_interface || true
	if [[ -n "${IFACE}" ]]; then
		local previous=""
		[[ -r "$(previous_root_file)" ]] && previous="$(cat "$(previous_root_file)")"
		if own_qdisc || ((DRY_RUN)); then
			run_tc qdisc del dev "${IFACE}" root
			if [[ -n "${previous}" && "${previous}" != "none" && "${previous}" != "noqueue" ]]; then
				if [[ "${previous}" == "mq" ]]; then
					# A multiqueue device gets its mq root back as soon as the HTB
					# root is removed; replace is a no-op then and restores it if not.
					run_tc qdisc replace dev "${IFACE}" root mq 2>/dev/null || true
				else
					run_tc qdisc replace dev "${IFACE}" root "${previous}" || warn "could not restore the previous root qdisc (${previous})"
				fi
			fi
		fi
		# A failed or partial apply may have left no ingress hook at all.
		run_tc qdisc del dev "${IFACE}" handle ffff: ingress 2>/dev/null || true
	fi
	if have_ifb; then
		if ((DRY_RUN)); then
			printf 'ip link del %s\n' "${IFB}"
		else
			ip link del "${IFB}" 2>/dev/null || true
		fi
	fi
	((DRY_RUN)) || rm -rf "${STATE_DIR}"
	return 0
}

# --- Watch ------------------------------------------------------------------
watch() {
	local interval="${TC_REFRESH_SECONDS}"
	((interval < 1)) && interval=1
	if ((ONCE)); then
		refresh_rules
		return 0
	fi
	trap 'exit 0' TERM INT
	while :; do
		refresh_rules || warn "refresh failed; the previous rules stay in place"
		sleep "${interval}" &
		wait $! || true
	done
}

# --- Main -------------------------------------------------------------------
parse_args() {
	while [[ $# -gt 0 ]]; do
		case "$1" in
		apply | refresh | status | diagnose | stop | validate | watch)
			COMMAND="$1"
			shift
			;;
		--dry-run)
			DRY_RUN=1
			shift
			;;
		--once)
			ONCE=1
			shift
			;;
		--config)
			CONFIG="${2:-}"
			shift 2
			;;
		--interface)
			TC_INTERFACE="${2:-}"
			shift 2
			;;
		-v | --verbose)
			VERBOSE=1
			shift
			;;
		-h | --help)
			usage
			exit 0
			;;
		*)
			die "unknown option: $1 (see --help)"
			;;
		esac
	done
	if [[ -z "${COMMAND}" ]]; then
		usage
		exit 1
	fi
}

main() {
	parse_args "$@"
	load_config
	validate_config || die "the bandwidth limits in ${CONFIG} are not usable; nothing was changed"

	if [[ "${COMMAND}" == "validate" ]]; then
		ok "bandwidth limits are valid: proxy ${PROXY_DOWNLOAD_LIMIT_MBIT}/${PROXY_UPLOAD_LIMIT_MBIT} Mbit/s down/up per client IP, TURN ${TURN_DOWNLOAD_LIMIT_MBIT}/${TURN_UPLOAD_LIMIT_MBIT} Mbit/s down/up per client IP"
		return 0
	fi
	aqm_configure
	detect_discovery

	case "${COMMAND}" in
	apply | refresh | watch | stop)
		if ((DRY_RUN == 0 && EUID != 0)); then
			die "changing traffic-control rules needs root"
		fi
		;;
	esac
	detect_interface || {
		if [[ "${COMMAND}" == "status" ]]; then
			status
			exit 1
		fi
		die "no network interface detected; set TC_INTERFACE in ${CONFIG}"
	}

	case "${COMMAND}" in
	apply)
		if all_limits_disabled; then
			stop_shaping
			ok "all bandwidth limits are set to 0; traffic shaping is disabled"
			return 0
		fi
		ensure_state_dir
		load_state
		apply_rules || die "could not install the traffic-shaping rules"
		if ((DRY_RUN)); then
			return 0
		fi
		if ! status >/dev/null; then
			fail "the rules were written but they are not active; run ${PROGRAM} status for details"
			return 1
		fi
		ok "per-client-IP bandwidth limits are installed on ${IFACE}"
		;;
	refresh)
		ensure_state_dir
		load_state
		refresh_rules
		;;
	watch)
		ensure_state_dir
		load_state
		watch
		;;
	status)
		status
		;;
	diagnose)
		diagnose
		;;
	stop)
		stop_shaping
		if ((DRY_RUN == 0)); then
			ok "traffic shaping removed"
		fi
		;;
	esac
}

main "$@"
