# Pishcord Relay - network configuration and credential endpoint
#
# Path on the server: /etc/pishcord-relay/config.env
# Read by: /usr/local/bin/pishcord-relay

# --- Public identity -------------------------------------------------------
# The HTTPS CONNECT proxy as clients must reach it. This is the address Pishcord
# puts in its Custom Profile, and the URL quoted in /network-config.
HTTPS_PROXY_URL=https://@PUBLIC_HOST@:@PROXY_PORT@

# The port of the Network Configuration API. This is the authoritative value:
# HTTPS_LISTEN and the port in NETWORK_CONFIG_URL must match it.
NETWORK_CONFIG_PORT=@API_PORT@

# The public URL of this endpoint, printed by the installer.
NETWORK_CONFIG_URL=https://@PUBLIC_HOST@:@API_PORT@/network-config

# --- TURN ------------------------------------------------------------------
# TURN URLs handed to Pishcord clients. UDP first, TLS/TCP as the fallback.
TURN_URLS=turn:@PUBLIC_HOST@:3478?transport=udp,turns:@PUBLIC_HOST@:5349?transport=tcp

# TURN username identity. The temporary username is "<expiresAt>:Pishcord".
TURN_IDENTITY=Pishcord

# Lifetime of each issued credential.
CREDENTIAL_TTL=24h

# File holding the coturn shared secret (never served, never logged).
SECRET_FILE=/etc/pishcord-relay/turn-secret

# --- TLS -------------------------------------------------------------------
# TLS material for the HTTPS endpoint. The certbot deploy hook copies the
# certificate here so the service can read it without running as root.
TLS_CERT_FILE=@TLS_DIR@/fullchain.pem
TLS_KEY_FILE=@TLS_DIR@/privkey.pem

# HTTPS endpoint (the public API). Port 443 belongs to the CONNECT proxy.
HTTPS_LISTEN=:@API_PORT@

# Plain HTTP is used only to answer ACME HTTP-01 challenges on port 80.
HTTP_LISTEN=:80
ACME_WEBROOT=/var/www/pishcord-relay

# --- Destination policy ----------------------------------------------------
# Read by the endpoint (so /network-config advertises exactly what the proxy
# enforces) and by `pishcord-relay -policy-apply`.
ALLOWED_DOMAINS_FILE=/etc/pishcord-relay/allowed-domains.txt
DESTINATION_POLICY_FILE=/etc/pishcord-relay/destination-policy.conf
POLICY_STATE_FILE=/etc/pishcord-relay/policy.json
SQUID_CONF=/etc/pishcord-relay/squid.conf
SQUID_ALLOW_FILE=/etc/pishcord-relay/squid-allow.conf
SQUID_BINARY=@SQUID_BINARY@

# --- Rate limits -----------------------------------------------------------
# One Pishcord profile load is one API request, and several profiles may load at
# the same moment, so the burst has to be comfortably larger than that. The
# global values are a ceiling for the whole relay, above the per-IP allowance.
PER_IP_RATE_PER_MINUTE=@PER_IP_RATE_PER_MINUTE@
PER_IP_BURST=@PER_IP_BURST@
GLOBAL_RATE_PER_MINUTE=@GLOBAL_RATE_PER_MINUTE@
GLOBAL_BURST=@GLOBAL_BURST@

# --- Per-client-IP bandwidth limits ----------------------------------------
# Enforced with Linux tc by /usr/local/lib/pishcord-relay/pishcord-relay-tc,
# separately for the HTTPS proxy and the TURN relay, in each direction.
# Values are Mbit/s and aggregate per client IP: extra connections from one
# address share the same allowance. 0 disables that individual limit.
# The API's control traffic is never shaped.
PROXY_UPLOAD_LIMIT_MBIT=@PROXY_UPLOAD_LIMIT_MBIT@
PROXY_DOWNLOAD_LIMIT_MBIT=@PROXY_DOWNLOAD_LIMIT_MBIT@
TURN_UPLOAD_LIMIT_MBIT=@TURN_UPLOAD_LIMIT_MBIT@
TURN_DOWNLOAD_LIMIT_MBIT=@TURN_DOWNLOAD_LIMIT_MBIT@

# Traffic-shaping housekeeping. The interface is detected from the default
# route; set TC_INTERFACE to pin it. TC_MAX_CLIENTS bounds how many client
# addresses are tracked per service and direction (1-2047). Until an address
# has its own class it uses its service's fallback class, which carries the same
# rate, so a limit applies from the first packet; TC_REFRESH_SECONDS is how
# often the proxy's per-address table is refreshed (TURN's is read at most every
# 30 s, because its socket table is much larger on a busy relay).
TC_INTERFACE=
TC_MAX_CLIENTS=@TC_MAX_CLIENTS@
TC_REFRESH_SECONDS=@TC_REFRESH_SECONDS@

# Leaf queueing and client discovery. The defaults are chosen for real-time
# voice and are read by the helper only, so they need no installer flag.
# TC_AQM=auto uses fq_codel on every class and falls back to a bounded pfifo on
# a kernel without sch_fq_codel (TC_AQM=pfifo forces the fallback).
# TC_DISCOVERY=auto reads client addresses from the conntrack table, which is the
# only source that can name a UDP TURN client; proc and ss are fallbacks and ss
# cannot see UDP TURN clients at all.
TC_AQM=auto
TC_AQM_LIMIT=1000
TC_QUANTUM=1500
TC_DISCOVERY=auto
# How often the TURN client table is re-read. Empty means automatic: every
# refresh with conntrack, every 30 s with the /proc table.
TC_TURN_SCAN_SECONDS=

# Set to true only when the endpoint sits behind a reverse proxy that
# overwrites X-Forwarded-For. Not used in the default standalone deployment.
TRUST_PROXY_HEADER=false
