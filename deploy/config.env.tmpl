# Dohcord Relay - network configuration and credential endpoint
#
# Path on the server: /etc/dohcord-relay/config.env
# Read by: /usr/local/bin/dohcord-relay

# --- Public identity -------------------------------------------------------
# The HTTPS CONNECT proxy as clients must reach it. This is the address Dohcord
# puts in its Custom Profile, and the URL quoted in /network-config.
HTTPS_PROXY_URL=https://@PUBLIC_HOST@:@PROXY_PORT@

# The public URL of this endpoint, printed by the installer.
NETWORK_CONFIG_URL=https://@PUBLIC_HOST@:@API_PORT@/network-config

# --- TURN ------------------------------------------------------------------
# TURN URLs handed to Dohcord clients. UDP first, TLS/TCP as the fallback.
TURN_URLS=turn:@PUBLIC_HOST@:3478?transport=udp,turns:@PUBLIC_HOST@:5349?transport=tcp

# TURN username identity. The temporary username is "<expiresAt>:Dohcord".
TURN_IDENTITY=Dohcord

# Lifetime of each issued credential.
CREDENTIAL_TTL=24h

# File holding the coturn shared secret (never served, never logged).
SECRET_FILE=/etc/dohcord-relay/turn-secret

# --- TLS -------------------------------------------------------------------
# TLS material for the HTTPS endpoint. The certbot deploy hook copies the
# certificate here so the service can read it without running as root.
TLS_CERT_FILE=@TLS_DIR@/fullchain.pem
TLS_KEY_FILE=@TLS_DIR@/privkey.pem

# HTTPS endpoint (the public API). Port 443 belongs to the CONNECT proxy.
HTTPS_LISTEN=:@API_PORT@

# Plain HTTP is used only to answer ACME HTTP-01 challenges on port 80.
HTTP_LISTEN=:80
ACME_WEBROOT=/var/www/dohcord-relay

# --- Destination policy ----------------------------------------------------
# Read by the endpoint (so /network-config advertises exactly what the proxy
# enforces) and by `dohcord-relay -policy-apply`.
ALLOWED_DOMAINS_FILE=/etc/dohcord-relay/allowed-domains.txt
DESTINATION_POLICY_FILE=/etc/dohcord-relay/destination-policy.conf
POLICY_STATE_FILE=/etc/dohcord-relay/policy.json
SQUID_CONF=/etc/dohcord-relay/squid.conf
SQUID_ALLOW_FILE=/etc/dohcord-relay/squid-allow.conf
SQUID_BINARY=@SQUID_BINARY@

# --- Rate limits -----------------------------------------------------------
# Per-IP requests per minute and burst, then a global ceiling.
PER_IP_RATE_PER_MINUTE=6
PER_IP_BURST=3
GLOBAL_RATE_PER_MINUTE=120
GLOBAL_BURST=60

# Set to true only when the endpoint sits behind a reverse proxy that
# overwrites X-Forwarded-For. Not used in the default standalone deployment.
TRUST_PROXY_HEADER=false
