[Unit]
Description=Pishcord Relay network configuration and TURN credential endpoint
Documentation=https://github.com/Newipe/Pishcord-relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pishcord-relay
Group=pishcord-relay
ExecStart=/usr/local/bin/pishcord-relayd -config /etc/pishcord-relay/config.env
# Certificate renewal and secret rotation reload in place via SIGHUP.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s

# Binds the port from NETWORK_CONFIG_PORT (HTTPS_LISTEN) and :80 without
# running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Read-only filesystem apart from what the service actually needs.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
UMask=0077

[Install]
WantedBy=multi-user.target
