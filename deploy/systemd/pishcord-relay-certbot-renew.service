[Unit]
Description=Renew the Pishcord Relay IP certificate
Documentation=https://github.com/Newipe/Pishcord-relay
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The shortlived profile certificate is valid for ~160 hours, so the timer below
# runs often; certbot itself decides whether a renewal is due (half of the
# remaining lifetime for certificates valid less than 10 days).
ExecStart=@CERTBOT@ renew --cert-name pishcord-relay --deploy-hook /usr/local/bin/pishcord-relay-tls-deploy --non-interactive --quiet
Nice=10
