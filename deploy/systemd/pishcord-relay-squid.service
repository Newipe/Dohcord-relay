[Unit]
Description=Pishcord Relay HTTPS CONNECT proxy (Squid)
Documentation=https://github.com/Newipe/Pishcord-relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=pishcord-relay-squid
RuntimeDirectoryMode=0750
# Squid binds 443 as root and then drops to the unprivileged "proxy" user
# (cache_effective_user in squid.conf), so it must start as root.
ExecStart=@SQUID_BINARY@ -N -f /etc/pishcord-relay/squid.conf
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3s

# One descriptor per tunneled connection plus listeners.
LimitNOFILE=65536

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
NoNewPrivileges=true
ReadWritePaths=/run/pishcord-relay-squid /var/log/pishcord-relay/squid

[Install]
WantedBy=multi-user.target
